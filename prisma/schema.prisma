generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Booking {
  id          String   @id @default(cuid())
  name        String
  email       String
  startTime   DateTime
  endTime     DateTime
  projectType String?
  notes       String?
  createdAt   DateTime @default(now())

  @@index([startTime])
}
